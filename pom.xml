<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>yunqi.zhibei</groupId>
    <artifactId>steward-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Yunqi Steward</name>
    <description>Managed lifecycle and vendor-neutral observation for native middleware clients</description>

    <modules>
        <!-- Vendor-neutral core -->
        <module>core/observation</module>
        <module>core/lifecycle</module>
        <module>core/refresh</module>
        <module>core/restart</module>

        <!-- Optional external-system adapters -->
        <module>adapters/configuration/nacos3</module>
        <module>adapters/observability/micrometer</module>
        <module>adapters/observability/jfr</module>
        <module>adapters/observability/opentelemetry</module>
        <module>adapters/observability/slf4j</module>

        <!-- Binding-author support -->
        <module>support/binding-testkit</module>

        <!-- Native SDK bindings: middleware / driver / major line -->
        <module>bindings/redis/jedis/v5</module>
        <module>bindings/redis/jedis/v7</module>
        <module>bindings/redis/lettuce/v6</module>
        <module>bindings/redis/redisson/v4</module>

        <module>bindings/mysql/connectorj/v9</module>
        <module>bindings/mysql/mariadb/v3</module>
        <module>bindings/postgresql/jdbc/v42</module>
        <module>bindings/clickhouse/jdbc/v0</module>
        <module>bindings/mongodb/sync/v5</module>
        <module>bindings/neo4j/driver/v6</module>

        <module>bindings/elasticsearch/java/v9</module>
        <module>bindings/milvus/sdk/v2</module>
        <module>bindings/minio/java/v8</module>

        <module>bindings/nacos/client/v3</module>
        <module>bindings/etcd/jetcd/v0</module>
        <module>bindings/zookeeper/curator/v5</module>
        <module>bindings/consul/api/v1</module>

        <module>bindings/kafka/client/v3</module>
        <module>bindings/pulsar/client/v3</module>
        <module>bindings/rabbitmq/client/v5</module>
        <module>bindings/rocketmq/client/v5</module>

        <module>bindings/elasticjob/lite/v3</module>
        <module>bindings/powerjob/worker/v5</module>
        <module>bindings/xxljob/core/v2</module>
        <module>bindings/seata/tm/v2</module>

        <!-- Non-published verification tools -->
        <module>examples/observation-e2e</module>
        <module>benchmarks/observation</module>

        <!-- Published version alignment -->
        <module>bom</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <testcontainers.docker.api.version>1.40</testcontainers.docker.api.version>
        <commons-codec.version>1.19.0</commons-codec.version>
        <jedis5.version>5.2.0</jedis5.version>
        <jedis7.version>7.0.0</jedis7.version>
        <lettuce6.version>6.8.2.RELEASE</lettuce6.version>
        <redisson4.version>4.3.1</redisson4.version>
        <hikari.version>6.3.0</hikari.version>
        <mysql9.version>9.7.0</mysql9.version>
        <mariadb3.version>3.5.10</mariadb3.version>
        <postgresql42.version>42.7.7</postgresql42.version>
        <clickhouse0.version>0.9.0</clickhouse0.version>
        <elasticsearch9.version>9.4.4</elasticsearch9.version>
        <minio8.version>8.6.0</minio8.version>
        <okhttp.version>5.1.0</okhttp.version>
        <nacos3.version>3.1.1</nacos3.version>
        <spotbugs.annotations.version>4.9.6</spotbugs.annotations.version>
        <neo4j6.version>6.2.0</neo4j6.version>
        <jetcd0.version>0.8.5</jetcd0.version>
        <curator5.version>5.8.0</curator5.version>
        <milvus2.version>2.6.0</milvus2.version>
        <elasticjob3.version>3.0.4</elasticjob3.version>
        <rocketmq5.version>5.3.2</rocketmq5.version>
        <powerjob5.version>5.1.2</powerjob5.version>
        <xxljob2.version>2.5.0</xxljob2.version>
        <seata2.version>2.0.0</seata2.version>
        <kafka3.version>3.9.1</kafka3.version>
        <pulsar3.version>3.3.0</pulsar3.version>
        <rabbitmq5.version>5.25.0</rabbitmq5.version>
        <mongodb-driver-sync5.version>5.5.1</mongodb-driver-sync5.version>
        <consul-api1.version>1.4.5</consul-api1.version>
        <maven.compiler.version>3.14.0</maven.compiler.version>
        <maven.surefire.version>3.5.3</maven.surefire.version>
        <maven.enforcer.version>3.5.0</maven.enforcer.version>
        <maven.source.version>3.3.1</maven.source.version>
        <maven.javadoc.version>3.11.2</maven.javadoc.version>
        <japicmp.version>0.26.1</japicmp.version>
        <jmh.version>1.37</jmh.version>
        <micrometer.version>1.17.0</micrometer.version>
        <opentelemetry.version>1.64.0</opentelemetry.version>
        <slf4j.version>2.0.18</slf4j.version>
        <maven.shade.version>3.6.1</maven.shade.version>
        <maven.deploy.version>3.1.4</maven.deploy.version>
        <japicmp.ignoreMissingOldVersion>true</japicmp.ignoreMissingOldVersion>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-observation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-lifecycle</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-refresh</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-restart</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-observability-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-observability-jfr</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-observability-opentelemetry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-observability-slf4j</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-binding-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>steward-configuration-nacos3</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>${commons-codec.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>${micrometer.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-contract</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <api.version>${testcontainers.docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.version}</version>
                <configuration>
                    <doclint>all,-missing</doclint>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>${japicmp.version}</version>
                <configuration>
                    <!-- This Mojo-level flag is intentionally outside <parameter>; it enforces the build gate. -->
                    <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                    <parameter>
                        <accessModifier>protected</accessModifier>
                        <onlyModified>true</onlyModified>
                        <ignoreMissingOldVersion>${japicmp.ignoreMissingOldVersion}</ignoreMissingOldVersion>
                        <skipPomModules>true</skipPomModules>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <id>check-binary-api-compatibility</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>${maven.deploy.version}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release-staging</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-release-version</id>
                                <phase>validate</phase>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules><requireReleaseVersion/></rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>baseline-compatibility</id>
            <properties>
                <japicmp.ignoreMissingOldVersion>false</japicmp.ignoreMissingOldVersion>
            </properties>
        </profile>
    </profiles>
</project>
